# Copy to .env and fill in. Never commit .env.
#
# One file for everything: thiel_common.py and rag/ both read the NEAREST .env
# walking up from the repo. If you already keep keys in a parent folder's .env,
# add the new keys there instead of creating a second file here, or the
# notebooks will stop seeing their SEC / Census / FRED keys.

# --- Analysis notebooks (thiel_common.py) ---
SEC_USER_AGENT="Your Name you@example.com"
CENSUS_API_KEY=
FRED_API_KEY=

# --- Claude (agent, note alignment, eval) ---
# anthropic | bedrock | vertex | foundry. Bedrock/Vertex/Foundry use their cloud credentials instead of the key.
CLAUDE_PROVIDER=anthropic
CLAUDE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- OpenAI embeddings (book, notes and analysis indexes; query vectors) ---
OPENAI_API_KEY=
# Pin an exact model name. Changing it means re-embedding every index.
OPENAI_EMBEDDING_MODEL=

# --- Corpus ---
# Set to true only once a licensed copy of the book is in sources/book/ (phase 0 exit criterion).
RAG_BOOK_LICENSED=false
